# TERRA OS — environment
# Copy to .env.local (or .env) and fill in. The MVP runs with no paid API keys.

# ── DATABASE ─────────────────────────────────────────────────────────────────
# !!  THIS MUST BE A DATABASE USED ONLY BY TERRA OS.  !!
#
# `npm run db:reset` runs `prisma migrate reset --force`, which DROPS EVERY
# TABLE at this URL without asking. If this connection string is ever pointed
# at a database another project shares — 65roses, or anything else on this
# machine — that command destroys the other project's data, and there is no
# undo.
#
# The database name must contain "terraos". scripts/check-repo.mjs enforces it
# before dev, build, test and db:reset will run.
DATABASE_URL="postgresql://terra:terra@127.0.0.1:5432/terraos_dev?schema=public"

# ── AUTH ─────────────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3100"

# ── APP ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="Terra OS"
# Renders the "Illustrative Demo Data" discipline throughout the UI.
NEXT_PUBLIC_DEMO_MODE="true"

# ── MAP (optional) ───────────────────────────────────────────────────────────
# Without a token the origination heatmap falls back to a list + schematic view.
NEXT_PUBLIC_MAPBOX_TOKEN=""

# ── INTELLIGENCE (optional, off by default) ──────────────────────────────────
# "none" keeps Terra Intelligence fully deterministic and local.
# Confidential data is never sent to an external model unless this is
# explicitly configured. See src/lib/providers/llm.ts.
LLM_PROVIDER="none"
ANTHROPIC_API_KEY=""
